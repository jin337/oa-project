# 本地/部署环境变量示例。复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，禁止提交。
# .env 仅供 dev/test，只加载 OA_* 变量；APP_ENV 请通过启动命令设置，.env 不加载 APP_ENV。

# 至少 32 字节随机值。开发/测试未设置时会生成进程级临时密钥。
OA_JWT_SECRET=

# 数据库连接。生产必须使用最小权限账号，禁止 root。
OA_MYSQL_HOST=127.0.0.1
OA_MYSQL_PORT=3306
OA_MYSQL_USERNAME=
OA_MYSQL_PASSWORD=
OA_MYSQL_DBNAME=

# 生产 CORS：逗号分隔的具体来源；同域部署可设 OA_CORS_ENABLE=false。
# OA_CORS_ENABLE=true
# OA_CORS_ALLOW_ORIGINS=https://oa.example.com

# Nginx 等反向代理网段，逗号分隔；本机直连留空（不信任任何代理）。
# OA_TRUSTED_PROXIES=127.0.0.1/32

# 生产默认关闭自动迁移；首次部署临时设 true，并视情况把 mode 设为 full。
# OA_MIGRATE_ENABLE=false
# OA_MIGRATE_MODE=incremental

# 初始化管理员。密码至少 12 位；生产未设置时迁移失败并拒绝启动。
OA_ADMIN_USERNAME=admin
OA_ADMIN_PASSWORD=
OA_ADMIN_EMAIL=admin@local
